# Claude Code local session/config - not part of the app
.claude/

# Dependencies (regenerated via npm install / composer install)
node_modules/
/backend/vendor/

# Environment files - all variants, both apps. Never commit real secrets.
.env
.env.*
!.env.example

# Frontend build output (regenerated via npm run build)
/frontend/dist/
/frontend/dist-ssr/

# Backend public build/runtime symlinks
/backend/public/build/
/backend/public/hot/
/backend/public/storage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.local
